{
    "name": "bulbula/cms",
    "description": "Content Management System for BNEO Commerce",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "BNEO Team",
            "email": "dev@example.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "mews/purifier": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "Bulbula\\CMS\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bulbula\\CMS\\Providers\\CMSServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
