{
    "name": "bulbula/uieditor",
    "description": "Visual drag-and-drop UI Editor (Elementor-style) for BNEO Commerce",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "BNEO Team",
            "email": "dev@example.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "bulbula/cms": "*"
    },
    "autoload": {
        "psr-4": {
            "Bulbula\\UIEditor\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bulbula\\UIEditor\\Providers\\UIEditorServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
