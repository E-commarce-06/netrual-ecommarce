# Keep APP_NAME equal to BRAND_NAME (see config/brand.php)
APP_NAME=BNEO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_VERSION=1.0.15

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bulbula
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Production:

# ─── Payment Gateways (configure in Admin → Settings → Payment Methods) ───
# STRIPE_KEY=
# STRIPE_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox
# PHONEPE_MERCHANT_ID=
# PHONEPE_SALT_KEY=
# PHONEPE_SALT_INDEX=1
# PHONEPE_ENV=UAT
# PAYUMONEY_KEY=
# PAYUMONEY_SALT=
# ---- Brand (see config/brand.php) ----
BRAND_NAME=BNEO
BRAND_SLUG=bneo
BRAND_VENDOR=bneo
BRAND_COMPANY=BNEO
BRAND_TAGLINE="E-commerce Platform"
BRAND_POWERED_BY=BNEO
BRAND_COPYRIGHT_HOLDER=BNEO
BRAND_AUTHOR="BNEO Team"
BRAND_LOGO=/logos/bneo-logo-primary.png
BRAND_LOGO_DARK=/logos/bneo-logo-reversed.png
BRAND_LOGO_ICON=/logos/bneo-app-icon.png
BRAND_FAVICON=/logos/bneo-favicon-64.png
BRAND_FAVICON_32=/logos/bneo-favicon-32.png
BRAND_DEFAULT_THEME=bulbula-default
BRAND_HOMEPAGE=https://github.com/E-commarce-06/netrual-ecommarce
BRAND_AUTHOR_URL=
BRAND_SUPPORT_EMAIL=
BRAND_NEWSLETTER_URL=
BRAND_NEWSLETTER_SECRET=
BRAND_REMOTE_THEME_DIRECTORY=false
