{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bulbula/bulbula",
    "version": "1.0.15",
    "type": "project",
    "description": "Open source eCommerce for Laravel, Inertia.js and Vue 3.",
    "keywords": [
        "laravel",
        "ecommerce",
        "inertia",
        "vue",
        "bulbula"
    ],
    "homepage": "https://github.com/E-commarce-06/netrual-ecommarce",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/Bulbula/PhonePe/sdk"
        }
    ],
    "require": {
        "php": "^8.3",
        "aws/aws-sdk-php": "^3.357",
        "inertiajs/inertia-laravel": "^2.0",
        "intervention/image": "^3.0",
        "laravel/fortify": "^1.30",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.9",
        "mews/purifier": "^3.4.4",
        "mpdf/mpdf": "^8.2",
        "netresearch/jsonmapper": "^4.4",
        "phonepe/pg-php-sdk-v2": "^2.0",
        "razorpay/razorpay": "^2.9",
        "spatie/laravel-backup": "^10.0",
        "stripe/stripe-php": "^18.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.1",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "files": [
            "packages/Bulbula/Core/src/Helpers/hooks.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Bulbula\\Core\\": "packages/Bulbula/Core/src/",
            "Bulbula\\Core\\Database\\Seeders\\": "packages/Bulbula/Core/src/Database/Seeders/",
            "Bulbula\\Admin\\": "packages/Bulbula/Admin/src/",
            "Bulbula\\Admin\\Database\\Seeders\\": "packages/Bulbula/Admin/src/Database/Seeders/",
            "Bulbula\\Product\\": "packages/Bulbula/Product/src/",
            "Bulbula\\Product\\Database\\Seeders\\": "packages/Bulbula/Product/src/Database/Seeders/",
            "Bulbula\\Cart\\": "packages/Bulbula/Cart/src/",
            "Bulbula\\Shop\\": "packages/Bulbula/Shop/src/",
            "Bulbula\\Shop\\Database\\Seeders\\": "packages/Bulbula/Shop/src/Database/Seeders/",
            "Bulbula\\Settings\\": "packages/Bulbula/Settings/src/",
            "Bulbula\\Settings\\Database\\Seeders\\": "packages/Bulbula/Settings/src/Database/Seeders/",
            "Bulbula\\Stripe\\": "packages/Bulbula/Stripe/src/",
            "Bulbula\\Razorpay\\": "packages/Bulbula/Razorpay/src/",
            "Bulbula\\PayPal\\": "packages/Bulbula/PayPal/src/",
            "Bulbula\\PayUMoney\\": "packages/Bulbula/PayUMoney/src/",
            "Bulbula\\PhonePe\\": "packages/Bulbula/PhonePe/src/",
            "Bulbula\\Sales\\": "packages/Bulbula/Sales/src/",
            "Bulbula\\Customer\\": "packages/Bulbula/Customer/src/",
            "Bulbula\\CMS\\": "packages/Bulbula/CMS/src/",
            "Bulbula\\UIEditor\\": "packages/Bulbula/UIEditor/src/",
            "Bulbula\\System\\": "packages/Bulbula/System/src/",
            "Bulbula\\Reports\\": "packages/Bulbula/Reports/src/",
            "Bulbula\\Marketing\\": "packages/Bulbula/Marketing/src/",
            "Bulbula\\API\\": "packages/Bulbula/API/",
            "Bulbula\\Setup\\": "packages/Bulbula/Setup/src/",
            "Bulbula\\Setup\\Database\\Seeders\\": "packages/Bulbula/Setup/src/Database/Seeders/",
            "Bulbula\\Blog\\": "packages/Bulbula/Blog/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" --names='server,queue,vite'"
        ],
        "dev:ssr": [
            "npm run build:ssr",
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"php artisan inertia:start-ssr\" --names=server,queue,logs,ssr --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"echo PHP_EOL . '════════════════════════════════════════════════════' . PHP_EOL . '  Bulbula installed! Run: php artisan bulbula:install' . PHP_EOL . '════════════════════════════════════════════════════' . PHP_EOL;\""
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "archive": {
        "exclude": [
            "/public/build",
            "/public/hot",
            "/node_modules",
            "/.git",
            "/storage/logs/*.log",
            "/storage/framework/cache",
            "/storage/framework/sessions",
            "/storage/framework/views"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
