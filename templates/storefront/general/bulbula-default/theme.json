{
    "name": "BNEO Storefront",
    "slug": "bulbula-default",
    "description": "A mobile-first BNEO storefront with navy and orange branding, quick view, and a responsive shopping experience.",
    "author": "BNEO",
    "version": "2.0.0",
    "author_url": "https://example.com",
    "screenshot": "screenshots/theme-preview.svg",
    "is_default": true,
    "supports": [
        "widgets",
        "menus",
        "custom-logo",
        "custom-colors",
        "responsive",
        "dark-mode"
    ],
    "settings": {
        "colors": {
            "primary": "#041735",
            "secondary": "#17355c",
            "accent": "#F47015",
            "success": "#10b981",
            "danger": "#ef4444",
            "warning": "#f59e0b",
            "info": "#46658a"
        },
        "typography": {
            "font_family": "Inter, sans-serif",
            "font_size": "16px",
            "heading_font": "Inter, sans-serif"
        },
        "layout": {
            "container_width": "1280px",
            "sidebar_width": "300px",
            "header_style": "default",
            "footer_style": "default"
        },
        "features": {
            "sticky_header": true,
            "back_to_top": true,
            "wishlist": true,
            "quick_view": true,
            "product_zoom": true,
            "show_platform_branding": false
        }
    }
}
